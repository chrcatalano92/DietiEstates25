<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutDialog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/custom_rectangle"
            android:importantForAccessibility="no"
            android:padding="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="400dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialogClose"
                style="@style/Widget.Material3.Button.ElevatedButton.Icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:backgroundTint="@color/transparent_20pct_white"
                android:contentDescription="@string/counteroffer_cancel_btn"
                android:elevation="12dp"
                android:padding="10dp"
                android:translationZ="12dp"
                app:icon="@drawable/Close"
                app:iconSize="28dp"
                app:iconTint="@color/Text"
                app:layout_constraintBottom_toBottomOf="@+id/dialogTitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.960"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.1"
                app:rippleColor="@color/primary_20pct"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeColor="@color/white_50pct"
                app:tint="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/dialogTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="56dp"
                android:gravity="center_horizontal"
                android:text="@string/dialogCounterofferTitle"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="@color/Text"
                android:textSize="@dimen/text_title"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@+id/dialogSubtitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/dialogClose"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/dialogSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_horizontal"
                android:text="@string/dialogCounterofferSubtitle"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/Text"
                android:textSize="@dimen/text_size"
                android:textStyle="italic"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/dialogTitle" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/counterofferInputLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@color/Background_TextField_Counteroffer_dialog"
                android:hint="@string/insert_amount"
                android:textColorHint="@color/TextColorHint_Counteroffer_dialog"
                app:errorEnabled="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/dialogSubtitle"
                app:startIconDrawable="@drawable/Euro">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/counterofferInput"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginEnd="2dp"
                    android:layout_marginBottom="2dp"
                    android:gravity="center_horizontal"
                    android:imeOptions="actionNext"
                    android:inputType="numberDecimal"
                    android:minWidth="400dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/Text"
                    android:textColorHighlight="@color/Text"
                    android:textColorHint="@color/Text"
                    android:textSize="@dimen/text_size" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/counterofferNotesLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@color/Background_TextField_Counteroffer_dialog"
                android:gravity="center_horizontal"
                android:hint="@string/notes_hint"
                android:textColorHint="@color/TextColorHint_Counteroffer_dialog"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.700"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/counterofferInputLayout">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/counterofferNotesInput"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:imeOptions="actionDone"
                    android:inputType="textMultiLine"
                    android:minWidth="400dp"
                    android:minLines="2"
                    android:textSize="@dimen/text_size" />
            </com.google.android.material.textfield.TextInputLayout>

            <Button
                android:id="@+id/btn_send_counteroffer"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/Background1.2"
                android:text="@string/counteroffer_send_btn"
                android:textColor="@color/Text"
                android:textSize="@dimen/text_size"
                app:cornerRadius="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/counterofferNotesLayout" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageView
            android:id="@+id/imgDialog"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            android:importantForAccessibility="no"
            android:src="@drawable/EuroIcon"
            app:layout_constraintBottom_toTopOf="@id/layoutDialog"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/layoutDialog" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>