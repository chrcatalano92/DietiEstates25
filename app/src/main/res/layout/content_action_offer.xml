<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@color/Background"
    android:orientation="horizontal"
    android:padding="16dp">

    <ImageButton
        android:id="@+id/acceptOff"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_margin="8dp"
        android:src="@drawable/AcceptOffer"
        android:scaleType="centerCrop"
        android:contentDescription="@string/acceptOff"
        style="@style/BorderlessSelectableItemBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/rejectOff"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_chainStyle="spread" />

    <ImageButton
        android:id="@+id/rejectOff"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_margin="8dp"
        android:src="@drawable/RejectOffer"
        android:scaleType="centerCrop"
        android:contentDescription="@string/rejectOff"
        style="@style/BorderlessSelectableItemBackground"
        app:layout_constraintStart_toEndOf="@id/acceptOff"
        app:layout_constraintEnd_toStartOf="@id/counterOff"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0.5" />

    <ImageButton
        android:id="@+id/counterOff"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_margin="8dp"
        android:src="@drawable/Counteroffer"
        android:scaleType="centerCrop"
        style="@style/BorderlessSelectableItemBackground"
        android:contentDescription="@string/make_counteroffer"
        app:layout_constraintStart_toEndOf="@id/rejectOff"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>