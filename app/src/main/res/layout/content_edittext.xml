<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/BackgroundArc"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/position_filter"
        android:textSize="20sp"
        android:textColor="@color/Text"
        android:textStyle="bold" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="@color/cardview_shadow_start_color"
        app:cardCornerRadius="8dp"
        app:cardElevation="1dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_start"
            android:layout_marginTop="@dimen/margin_start"
            android:text="@string/chosen_filter_editTxt"
            android:textSize="@dimen/text_size"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/cityEditTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_start"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="@dimen/margin_start"
            android:hint="@string/insert_here"
            android:inputType="text"
            android:minWidth="400dp"
            android:padding="16dp"
            android:textAlignment="center"
            android:textColor="@color/Text"
            android:textColorHint="@color/Text"
            android:textSize="@dimen/text_size"
            android:imeOptions="actionDone"
            tools:ignore="Autofill,SpeakableTextPresentCheck" />
    </androidx.cardview.widget.CardView>

</LinearLayout>