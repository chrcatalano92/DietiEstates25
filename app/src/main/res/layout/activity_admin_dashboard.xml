<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".dashboards.administrator_area.AdminDashboardActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:paddingBottom="30dp">

        <include
            android:id="@+id/contentDashboard"
            layout="@layout/content_dashboard"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/row1"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:orientation="horizontal"
            android:padding="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/contentDashboard">

            <androidx.cardview.widget.CardView
                android:id="@+id/card1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="10dp"
                android:layout_weight="1"
                android:backgroundTint="@color/Background"
                android:clickable="true"
                android:focusable="true"
                style="@style/SelectableItemBackground"
                app:cardElevation="20dp"
                app:cardMaxElevation="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/newAM"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/AMImg"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="10dp"
                        android:gravity="center_horizontal"
                        android:text="@string/new_agency_m"
                        android:textColor="@color/Text"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/AMImg"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="15dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/Person" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/row1"
            app:layout_constraintVertical_bias="0.0">

            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="10dp"
                android:layout_weight="1"
                android:backgroundTint="@color/Background"
                app:cardElevation="20dp"
                app:cardMaxElevation="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/newAccountSupport"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/AccountSuppImg"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="10dp"
                        android:text="@string/new_support_a"
                        android:textColor="@color/Text"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:gravity="center_horizontal" />

                    <ImageView
                        android:id="@+id/AccountSuppImg"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="15dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/Admin" />

                    <LinearLayout
                        android:id="@+id/line"
                        android:layout_width="match_parent"
                        android:layout_height="5dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginTop="10dp"
                        android:layout_below="@+id/newAccountSupport"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@color/BackgroundArc" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/slide_panel"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_below="@+id/newAccountSupport"
                        android:layout_marginTop="20dp"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:padding="4dp">

                        <TextView
                            android:id="@+id/support1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/adm_ass"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true"
                            style="@style/SelectableItemBackground"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginBottom="10dp" />

                        <TextView
                            android:id="@+id/support2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/tech_supp"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true"
                            style="@style/SelectableItemBackground"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginBottom="10dp" />

                        <TextView
                            android:id="@+id/support3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dev"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true"
                            style="@style/SelectableItemBackground"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginBottom="10dp" />

                        <TextView
                            android:id="@+id/support4"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/an"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true"
                            style="@style/SelectableItemBackground"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginBottom="10dp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/toggleBtn"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:backgroundTint="@color/Background"
                        android:contentDescription="@string/show_hide_acc_list"
                        android:src="@android:drawable/arrow_down_float"
                        tools:ignore="ImageContrastCheck" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/row2">

            <include layout="@layout/content_add_dashboard_settings" />
        </LinearLayout>
        
        <LinearLayout
            android:id="@+id/row4"
            android:layout_width="0dp"
            android:layout_height="175dp"
            android:orientation="horizontal"
            android:padding="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/row3">
            
            <androidx.cardview.widget.CardView
                android:id="@+id/card4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="10dp"
                android:layout_weight="1"
                android:backgroundTint="@color/Background"
                android:clickable="true"
                android:focusable="true"
                style="@style/SelectableItemBackground"
                app:cardElevation="20dp"
                app:cardMaxElevation="20dp">
                
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    
                    <TextView
                        android:id="@+id/persData"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/persDataImg"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="10dp"
                        android:text="@string/pers_data"
                        android:textColor="@color/Text"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                    
                    <ImageView
                        android:id="@+id/persDataImg"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="15dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/PersonalDataManagement" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row5"
            android:layout_width="0dp"
            android:layout_height="175dp"
            android:orientation="horizontal"
            android:padding="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/row4"
            app:layout_constraintVertical_bias="0.0">

            <androidx.cardview.widget.CardView
                android:id="@+id/card5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="10dp"
                android:layout_weight="1"
                android:backgroundTint="@color/Background"
                android:clickable="true"
                android:focusable="true"
                style="@style/SelectableItemBackground"
                app:cardElevation="20dp"
                app:cardMaxElevation="20dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/manageUsers"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/usrGroupImg"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="10dp"
                        android:text="@string/usr_man"
                        android:textColor="@color/Text"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:gravity="center_horizontal" />

                    <ImageView
                        android:id="@+id/usrGroupImg"
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="15dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/UsersGroup" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/row6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/row5">

            <include layout="@layout/content_dashboard_server_state" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>