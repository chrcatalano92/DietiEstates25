<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/BackgroundArc"
    tools:context=".features.auth.ui.LoginUsrFragment">

    <include
        android:id="@+id/headerLayout"
        layout="@layout/content_account_header" />

    <include
        android:id="@+id/loginFromLayout"
        android:visibility="visible"
        layout="@layout/content_account_login" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="visible" />

    <TextView
        android:id="@+id/tVRegisterUsr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="80dp"
        android:padding="8dp"
        android:text="@string/regUsrBtn"
        android:textSize="@dimen/text_size"
        android:textColor="@color/Text"
        android:textAlignment="center"
        android:layout_marginTop="220dp" />

    <ImageButton
        android:id="@+id/exitBtn"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:layout_marginTop="270dp"
        android:backgroundTint="@color/Background"
        android:contentDescription="@string/back_btn"
        android:scaleType="centerInside"
        android:src="@drawable/Back" />

</FrameLayout>