<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/BackgroundBasicActivity"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/client_data_step1"
            android:textColor="@color/Text"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <include layout="@layout/horizontal_line" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:hint="@string/first_name"
            android:textColorHint="@color/Text"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:startIconDrawable="@drawable/Person">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/firstNameEditTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="400dp"
                android:layout_marginBottom="8dp"
                android:inputType="textPersonName"
                android:textColor="@color/Text"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="@string/last_name"
            android:textColorHint="@color/Text"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:startIconDrawable="@drawable/Person">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/lastNameEditTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="400dp"
                android:layout_marginBottom="8dp"
                android:inputType="textPersonName"
                android:textColor="@color/Text"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="@string/email"
            android:textColorHint="@color/Text"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:startIconDrawable="@drawable/Email">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/emailEditTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="400dp"
                android:layout_marginBottom="8dp"
                android:inputType="textEmailAddress"
                android:textColor="@color/Text"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="@string/phone_number"
            android:textColorHint="@color/Text"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:startIconDrawable="@drawable/Tel">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/phoneNumberEditTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="400dp"
                android:layout_marginBottom="8dp"
                android:inputType="number"
                android:textColor="@color/Text"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="@string/cell_phone"
            android:textColorHint="@color/Text"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:startIconDrawable="@drawable/CellPhone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/cellPhoneEditTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="400dp"
                android:layout_marginBottom="8dp"
                android:inputType="number"
                android:textColor="@color/Text"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/search_prop_step2"
            android:textColor="@color/Text"
            android:textStyle="bold"
            android:textSize="@dimen/text_title"
            android:layout_marginBottom="4dp" />

        <include layout="@layout/horizontal_line" />

        <Spinner
            android:id="@+id/regionsSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/provincesSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:enabled="false" />

        <Spinner
            android:id="@+id/citiesSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:enabled="false" />

        <Spinner
            android:id="@+id/titlePropertiesSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:enabled="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/client_offer_step3"
            android:textColor="@color/Text"
            android:textStyle="bold"
            android:textSize="@dimen/text_title" />

        <include layout="@layout/horizontal_line" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:hint="@string/manual_offer_hint"
            android:textColorHint="@color/Text"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:startIconDrawable="@drawable/Euro">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/offerEditTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="400dp"
                android:layout_marginBottom="8dp"
                android:inputType="numberDecimal"
                android:textColor="@color/Text"
                android:imeOptions="actionNext" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="@string/note_hint"
            android:textColorHint="@color/Text"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:startIconDrawable="@drawable/Edit">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/noteEditTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="400dp"
                android:layout_marginBottom="8dp"
                android:inputType="textMultiLine|textCapSentences"
                android:imeOptions="actionDone" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/final_status_step4"
            android:textColor="@color/Text"
            android:textStyle="bold"
            android:textSize="@dimen/text_title"
            android:layout_marginBottom="4dp" />

        <include layout="@layout/horizontal_line" />

        <Spinner
            android:id="@+id/statusSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/sendBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_gravity="center"
            android:text="@string/btnSend"
            android:textColor="@color/Text"
            android:backgroundTint="@color/Background"
            style="@style/SelectableItemBackground" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>