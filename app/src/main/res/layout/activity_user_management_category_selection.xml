<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    tools:context=".dashboards.administrator_area.additional_settings.usr_management.management_category_selection.UserManagementCategorySelectionActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.AppCompat.DayNight.ActionBar"
        android:background="@color/Background"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/Background" />

    </com.google.android.material.appbar.AppBarLayout>

    <include
        android:id="@+id/content_user_management_category_selection"
        layout="@layout/content_user_management_category_selection" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:layout_gravity="bottom">

        <RelativeLayout
            android:id="@+id/left_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true">

            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/left_fab_remove_user"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignStart="@+id/left_fab_suspend_user"
                android:layout_above="@+id/left_fab_suspend_user"
                android:layout_marginBottom="16dp"
                android:text="@string/remove"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/Text"
                android:visibility="invisible"
                app:backgroundTint="@color/Background" />

            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/left_fab_suspend_user"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignStart="@+id/main_left_fab_settings_account"
                android:layout_above="@+id/main_left_fab_settings_account"
                android:layout_marginBottom="16dp"
                android:text="@string/suspend"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/Text"
                android:visibility="invisible"
                app:backgroundTint="@color/Background" />

            <!-- Main Left Fab -->
            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/main_left_fab_settings_account"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="0dp"
                android:visibility="invisible"
                tools:visibility="visible"
                android:text="@string/set_account"
                android:textColor="@color/Text"
                app:backgroundTint="@color/Background"
                app:icon="@drawable/baseline_settings_24"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/Text" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/right_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_toEndOf="@+id/left_group">

            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/right_fab_real_estate_agent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@+id/right_fab_real_estate_a_m"
                android:layout_alignEnd="@+id/right_fab_real_estate_a_m"
                android:layout_marginBottom="16dp"
                android:text="@string/reserv_entries3"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/Text"
                android:visibility="invisible"
                app:backgroundTint="@color/Background" />

            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/right_fab_real_estate_a_m"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@id/right_fab_admin"
                android:layout_alignEnd="@+id/right_fab_admin"
                android:layout_marginBottom="16dp"
                android:text="@string/real_estate_a_m_role"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/Text"
                android:visibility="invisible"
                app:backgroundTint="@color/Background" />

            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/right_fab_admin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@+id/right_fab_user"
                android:layout_alignEnd="@+id/right_fab_user"
                android:layout_marginBottom="16dp"
                android:text="@string/reserv_entries1"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/Text"
                android:visibility="invisible"
                app:backgroundTint="@color/Background" />

            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/right_fab_user"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_above="@+id/main_right_fab_set_role"
                android:layout_alignEnd="@+id/main_right_fab_set_role"
                android:layout_marginBottom="16dp"
                android:text="@string/user_role"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/Text"
                android:visibility="invisible"
                android:backgroundTint="@color/Background" />

            <!-- Main Right Fab -->
            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/main_right_fab_set_role"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="-3dp"
                android:layout_marginBottom="2dp"
                android:visibility="invisible"
                tools:visibility="visible"
                android:text="@string/set_role"
                android:textColor="@color/Text"
                app:backgroundTint="@color/Background"
                app:icon="@drawable/outline_settings_account_box_24"
                app:iconPadding="8dp"
                app:iconTint="@color/Text" />
        </RelativeLayout>
    </RelativeLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>